{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Caelon Portal",
  "version": "0.1.0",
  "identifier": "com.caelonhq.portal",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'; object-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:",
      "capabilities": [
        "default",
        "portal-notifications"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Caelon Portal desktop shell",
    "longDescription": "Desktop shell for the hosted Caelon Portal web application.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
